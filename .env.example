# echo answers locally with no API key. Use http to call a real OpenAI-compatible server.
TOKENTRIM_UPSTREAM_MODE=echo
TOKENTRIM_UPSTREAM_BASE_URL=https://api.openai.com/v1
TOKENTRIM_UPSTREAM_API_KEY=

# Set this to require Authorization: Bearer <key> on /v1/* requests.
TOKENTRIM_PROXY_API_KEY=

# memory | redis | pgvector
TOKENTRIM_CACHE_BACKEND=memory
TOKENTRIM_REDIS_HOST=localhost
TOKENTRIM_REDIS_PORT=6379
TOKENTRIM_REDIS_PASSWORD=

TOKENTRIM_PG_URL=jdbc:postgresql://localhost:5432/tokentrim
TOKENTRIM_PG_USER=tokentrim
TOKENTRIM_PG_PASSWORD=tokentrim

# hashing (offline) | openai (POST /embeddings on the upstream base URL)
TOKENTRIM_EMBEDDINGS_PROVIDER=hashing
